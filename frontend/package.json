{
  "name": "vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:watch": "vitest --project browser",
    "test:smoke": "playwright test --grep @smoke",
    "test:contract": "playwright test --config playwright.contract.config.ts",
    "fixture:capture": "node scripts/capture-shitposts-fixture.mjs",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:browser && npm test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "msw": "^2.15.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
