# Copy to .env to run the app: cp .env.example .env
#
# Nothing here is secret — both origins are public endpoints. Anything that
# ever is secret belongs in .env.local, which is also gitignored.

# Origins the Vite dev server proxies to. Server-side only — never bundled,
# never reaches the browser.
AWS_API_ORIGIN=https://iv2saq46m9.execute-api.eu-west-2.amazonaws.com
AWS_MEDIA_ORIGIN=https://d1i2liswslkj07.cloudfront.net

# Same-origin paths the browser actually calls. In dev the proxy above serves
# them; in production these become CloudFront behaviours pointing at API
# Gateway and the media bucket, so the app code stays identical either way.
# VITE_MEDIA_BASE_URL is empty because shitpostKey already carries its
# "media/" prefix.
VITE_API_BASE_URL=/api
VITE_MEDIA_BASE_URL=
